# Modal authentication is handled via the CLI:
#   pip install modal
#   modal token new
# This stores credentials in ~/.modal.toml (not in .env)

# HuggingFace (optional - for pushing models)
# HF_TOKEN=your_huggingface_token_here

# Gemini API (for synthetic Q&A generation)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here